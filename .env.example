# Локально: cp .env.example .env.local  (секрет сгенерируйте: openssl rand -base64 32)
# На сервере: /opt/calc/.env — создаёт deploy/vps/deploy.sh при первом запуске.

# Прод: postgres://… (задаёт compose). Локально не нужен: `pnpm dev` сам поднимает
# встроенный Postgres (PGlite) на 127.0.0.1:5433 и передаёт адрес в Next.
# DATABASE_URL=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Владелец, через запятую: не упирается в общий дневной лимит ИИ. Вход открыт всем.
# (Старое имя ALLOWED_EMAILS тоже читается.)
OWNER_EMAILS=
# open — регистрация открыта (по умолчанию); closed — аварийно: входят только те, кто уже есть
SIGNUP=open

# Почта для ссылок входа и удаления аккаунта. Пока пусто — ссылка пишется в лог сервера.
SMTP_URL=
MAIL_FROM=Calo <no-reply@egor.am>
# Писем на регистрацию (ссылка на адрес без аккаунта) за сутки UTC на всех — защита
# ящика от бана за спам; вход тех, кто уже есть, и удаление аккаунта не держит. По умолчанию 300
MAIL_DAILY_LIMIT=300
# Писем с одного IP за сутки UTC на любые адреса; по умолчанию 30
MAIL_IP_DAILY_LIMIT=30

# ИИ (этапы 6–7): разбор текста и фото — Gemini API, бесплатный уровень
GEMINI_API_KEY=
# Запросов к ИИ от всех пользователей за сутки (кроме владельца); по умолчанию 600
AI_GLOBAL_DAILY_LIMIT=600
