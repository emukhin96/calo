# Локально: cp .env.example .env.local  (секрет сгенерируйте: openssl rand -base64 32)
# На сервере: /opt/calc/.env — создаёт deploy/vps/deploy.sh при первом запуске.

# postgres://user:pass@host:5432/db  или  pglite:./.data/pg (встроенный, для разработки)
DATABASE_URL=pglite:./.data/pg

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Кому разрешён вход, через запятую
ALLOWED_EMAILS=

# Почта для ссылок входа. Пока пусто — ссылка пишется в лог сервера.
SMTP_URL=
MAIL_FROM=Calo <no-reply@egor.am>

# Этап 6
ANTHROPIC_API_KEY=
